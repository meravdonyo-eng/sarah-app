# Anthropic API Key
ANTHROPIC_API_KEY=your-api-key-here

# Server Port
PORT=3001

# Session Secret (required for MCP OAuth)
SESSION_SECRET=your-session-secret-change-in-production

# Backend URL (used for OAuth callbacks in production)
# Development: http://localhost:3001
# Production: https://your-backend.railway.app (replace with your actual Railway URL)
BACKEND_URL=http://localhost:3001

# Frontend URL (for CORS and redirects)
# Development: http://localhost:5173
# Production: https://your-frontend.railway.app (replace with your actual Railway URL)
FRONTEND_URL=http://localhost:5173

# Node environment (development or production)
NODE_ENV=development

# Admin token used to protect system prompt editing endpoints (/api/agent)
# Choose a long random string.
ADMIN_TOKEN=change-me

# Optional: Override OAuth callback URLs for specific integrations
# Only needed if you have custom callback URLs registered with the providers
# OAUTH_CALLBACK_URL_MIXPANEL=https://your-backend.railway.app/api/mcp/callback
# OAUTH_CALLBACK_URL_JIRA=https://your-backend.railway.app/api/mcp/callback

# Optional: Pre-registered OAuth client credentials (if not using dynamic registration)
# MIXPANEL_CLIENT_ID=your-mixpanel-client-id
# JIRA_CLIENT_ID=your-jira-client-id
# JIRA_CLIENT_SECRET=your-jira-client-secret
